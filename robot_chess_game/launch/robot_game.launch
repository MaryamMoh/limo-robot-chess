<?xml version="1.0"?>
<!-- Chess nodes of ONE robot: camera verification and the move executor. -->
<launch>
  <arg name="robot_name" default=""/>                 <!-- namespace, "" on the real robot -->
  <arg name="color"/>                                 <!-- side played by this robot -->
  <arg name="carrier_name" default="$(arg robot_name)"/>
  <arg name="base_frame" default="$(arg robot_name)/base_footprint"/>
  <arg name="board_config" default="$(find robot_chess_game)/config/board_sim.yaml"/>
  <arg name="image_topic" default="camera/color/image_raw"/>
  <arg name="carrier_ns" default="/chess_carrier"/>
  <arg name="verify_with_camera" default="true"/>

  <group ns="$(arg robot_name)">
    <node pkg="robot_chess_game" type="piece_vision.py" name="piece_vision" output="screen">
      <remap from="image" to="$(arg image_topic)"/>
      <param name="frames" value="5"/>
      <param name="timeout" value="15.0"/>
    </node>

    <node pkg="robot_chess_game" type="piece_mover.py" name="piece_mover" output="screen">
      <rosparam command="load" file="$(arg board_config)"/>
      <param name="robot_name" value="$(arg carrier_name)"/>
      <param name="color" value="$(arg color)"/>
      <param name="base_frame" value="$(arg base_frame)"/>
      <param name="global_frame" value="map"/>
      <param name="carrier_ns" value="$(arg carrier_ns)"/>
      <param name="verify_with_camera" value="$(arg verify_with_camera)"/>
      <param name="abort_on_mismatch" value="false"/>
    </node>
  </group>
</launch>
