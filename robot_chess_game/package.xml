<?xml version="1.0"?>
<package format="2">
  <name>robot_chess_game</name>
  <version>1.0.0</version>
  <description>
    Chess referee, player consoles, move execution (navigation + pick and place),
    camera based piece verification and board visualisation for two LIMO PRO robots.
  </description>
  <maintainer email="maryammohamedmahmoud@gmail.com">Maryam Abd-ElRahman</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>robot_chess_msgs</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>robot_chess_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <!-- python-chess is installed with pip (see requirements.txt) -->

  <test_depend>python3-pytest</test_depend>
</package>
