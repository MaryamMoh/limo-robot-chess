<?xml version="1.0"?>
<package format="2">
  <name>robot_chess_gazebo</name>
  <version>1.0.0</version>
  <description>Gazebo arena with a giant chessboard, piece spawning and simulated piece carrying.</description>
  <maintainer email="maryammohamedmahmoud@gmail.com">Maryam Abd-ElRahman</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>gazebo_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>robot_chess_description</exec_depend>
  <exec_depend>robot_chess_game</exec_depend>
  <exec_depend>robot_chess_msgs</exec_depend>
</package>
