<?xml version="1.0"?>
<!-- Spawn one LIMO PRO into the running Gazebo, inside namespace /<robot_name>. -->
<launch>
  <arg name="robot_name"/>
  <arg name="x" default="0.0"/>
  <arg name="y" default="0.0"/>
  <arg name="yaw" default="0.0"/>

  <group ns="$(arg robot_name)">
    <param name="robot_description"
           command="$(find xacro)/xacro '$(find robot_chess_description)/urdf/limo_pro.urdf.xacro' prefix:=$(arg robot_name)"/>

    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher">
      <param name="publish_frequency" value="30.0"/>
    </node>

    <node pkg="gazebo_ros" type="spawn_model" name="spawn_model" output="screen"
          args="-urdf -param robot_description -model $(arg robot_name)
                -x $(arg x) -y $(arg y) -z 0.02 -Y $(arg yaw)"/>
  </group>
</launch>
