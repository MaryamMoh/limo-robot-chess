<?xml version="1.0"?>
<!-- Gazebo with the chess arena and the 32 chess pieces. -->
<launch>
  <arg name="gui" default="true"/>
  <arg name="paused" default="false"/>
  <arg name="world" default="$(find robot_chess_gazebo)/worlds/chess_arena.world"/>
  <arg name="board_config" default="$(find robot_chess_game)/config/board_sim.yaml"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)"/>
    <arg name="gui" value="$(arg gui)"/>
    <arg name="paused" value="$(arg paused)"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <node pkg="robot_chess_gazebo" type="sim_piece_manager.py" name="chess_carrier" output="screen">
    <rosparam command="load" file="$(arg board_config)"/>
    <param name="carry_height" value="0.26"/>
  </node>
</launch>
