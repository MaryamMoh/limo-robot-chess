<?xml version="1.0"?>
<!--
  AgileX LIMO with a myCobot 280 arm, a parallel gripper and a wrist camera.

  The arm kinematics (joint names, origins, axes, limits) are those of
  AgileX's limo_cobot_sim model (limo_base.urdf) and of
  robot_chess_game/src/robot_chess/kinematics.py.  Link visuals are simple
  shapes (the original meshes are not needed); arm links have no collision
  geometry, so Gazebo never fights the position-controlled joints.

  Gazebo:
    * gazebo_ros_control with position-controlled joints
      (arm_controller, gripper_controller, joint_state_controller)
    * planar drive for the base (only used when the board is larger than the
      arm's reach and the robot changes position along it)
    * wrist RGB camera  /wrist_camera/image_raw  (frame wrist_camera_optical)

  Args: tcp_offset  flange -> grasp point between the finger tips [m]
-->
<robot name="limo_mycobot" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="tcp_offset" default="0.06"/>
  <xacro:property name="PI" value="3.14159265"/>
  <xacro:property name="J_LIMIT" value="2.8798"/>    <!-- 165 deg -->
  <xacro:property name="J6_LIMIT" value="3.0543"/>   <!-- 175 deg -->

  <material name="limo_grey"><color rgba="0.35 0.35 0.38 1"/></material>
  <material name="arm_white"><color rgba="0.92 0.92 0.92 1"/></material>
  <material name="arm_dark"><color rgba="0.15 0.15 0.15 1"/></material>

  <xacro:macro name="inertia" params="m">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*1e-3}" ixy="0" ixz="0" iyy="${m*1e-3}" iyz="0" izz="${m*1e-3}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="box_visual" params="xyz size material">
    <visual>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <geometry><box size="${size}"/></geometry>
      <material name="${material}"/>
    </visual>
  </xacro:macro>

  <!-- ============================================================ LIMO -->
  <link name="base_footprint"/>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 1.57"/>
      <geometry>
        <mesh filename="package://limo_description/meshes/limo_base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry><box size="0.32 0.22 0.2"/></geometry>
    </collision>
    <inertial>
      <mass value="4.2"/>
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.05"/>
    </inertial>
  </link>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry><cylinder radius="0.045" length="0.045"/></geometry>
        <material name="arm_dark"/>
      </visual>
      <xacro:inertia m="0.3"/>
    </link>
    <joint name="${name}_wheel" type="fixed">
      <parent link="base_link"/>
      <child link="${name}_wheel_link"/>
      <origin xyz="${x} ${y} -0.1" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
  <xacro:wheel name="front_left" x="0.1" y="0.0875"/>
  <xacro:wheel name="front_right" x="0.1" y="-0.0875"/>
  <xacro:wheel name="rear_left" x="-0.1" y="0.0875"/>
  <xacro:wheel name="rear_right" x="-0.1" y="-0.0875"/>

  <!-- ===================================================== myCobot 280 -->
  <link name="joint1">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry><cylinder radius="0.034" length="0.13"/></geometry>
      <material name="arm_white"/>
    </visual>
    <xacro:inertia m="0.25"/>
  </link>
  <joint name="limo_mycobot" type="fixed">
    <parent link="base_link"/>
    <child link="joint1"/>
    <origin xyz="-0.01 0 0" rpy="0 0 0"/>
  </joint>

  <link name="joint2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <material name="arm_white"/>
    </visual>
    <xacro:inertia m="0.15"/>
  </link>
  <link name="joint3">
    <xacro:box_visual xyz="-0.055 0 0.03" size="0.14 0.035 0.035" material="arm_white"/>
    <xacro:inertia m="0.15"/>
  </link>
  <link name="joint4">
    <xacro:box_visual xyz="-0.048 0 0.032" size="0.125 0.032 0.032" material="arm_white"/>
    <xacro:inertia m="0.12"/>
  </link>
  <link name="joint5">
    <xacro:box_visual xyz="0 -0.036 0" size="0.03 0.075 0.03" material="arm_white"/>
    <xacro:inertia m="0.08"/>
  </link>
  <link name="joint6">
    <xacro:box_visual xyz="0 0.022 0" size="0.03 0.045 0.03" material="arm_white"/>
    <xacro:inertia m="0.06"/>
  </link>
  <link name="joint6_flange">
    <visual>
      <origin xyz="0 0 0.004" rpy="0 0 0"/>
      <geometry><cylinder radius="0.02" length="0.008"/></geometry>
      <material name="arm_dark"/>
    </visual>
    <xacro:inertia m="0.03"/>
  </link>

  <xacro:macro name="arm_joint" params="name parent child xyz rpy limit">
    <joint name="${name}" type="revolute">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <axis xyz="0 0 1"/>
      <limit effort="1000.0" lower="${-limit}" upper="${limit}" velocity="2.0"/>
    </joint>
    <transmission name="${name}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${name}">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="${name}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

  <xacro:arm_joint name="joint2_to_joint1" parent="joint1" child="joint2"
                   xyz="0 0 0.13156" rpy="0 0 0" limit="${J_LIMIT}"/>
  <xacro:arm_joint name="joint3_to_joint2" parent="joint2" child="joint3"
                   xyz="0 0 0" rpy="0 1.5708 -1.5708" limit="${J_LIMIT}"/>
  <xacro:arm_joint name="joint4_to_joint3" parent="joint3" child="joint4"
                   xyz="-0.1104 0 0" rpy="0 0 0" limit="${J_LIMIT}"/>
  <xacro:arm_joint name="joint5_to_joint4" parent="joint4" child="joint5"
                   xyz="-0.096 0 0.06462" rpy="0 0 -1.5708" limit="${J_LIMIT}"/>
  <xacro:arm_joint name="joint6_to_joint5" parent="joint5" child="joint6"
                   xyz="0 -0.07318 0" rpy="1.5708 -1.5708 0" limit="${J_LIMIT}"/>
  <xacro:arm_joint name="joint6output_to_joint6" parent="joint6" child="joint6_flange"
                   xyz="0 0.0456 0" rpy="-1.5708 0 0" limit="${J6_LIMIT}"/>

  <!-- ========================================================= gripper -->
  <link name="gripper_base">
    <xacro:box_visual xyz="0 0 0.009" size="0.05 0.03 0.018" material="arm_dark"/>
    <xacro:inertia m="0.05"/>
  </link>
  <joint name="gripper_mount" type="fixed">
    <parent link="joint6_flange"/>
    <child link="gripper_base"/>
    <origin xyz="0 0 0.008" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="finger" params="side sign">
    <link name="finger_${side}">
      <xacro:box_visual xyz="0 0 0.026" size="0.004 0.012 0.044" material="arm_dark"/>
      <xacro:inertia m="0.01"/>
    </link>
    <joint name="finger_${side}_joint" type="prismatic">
      <parent link="gripper_base"/>
      <child link="finger_${side}"/>
      <origin xyz="${sign*0.002} 0 0.012" rpy="0 0 0"/>
      <axis xyz="${sign} 0 0"/>
      <limit effort="20" lower="0.0" upper="0.015" velocity="0.05"/>
    </joint>
    <transmission name="finger_${side}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="finger_${side}_joint">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
      </joint>
      <actuator name="finger_${side}_motor">
        <hardwareInterface>hardware_interface/PositionJointInterface</hardwareInterface>
        <mechanicalReduction>1</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>
  <xacro:finger side="left" sign="1"/>
  <xacro:finger side="right" sign="-1"/>

  <!-- tool centre point: between the finger tips -->
  <link name="tcp"/>
  <joint name="tcp_joint" type="fixed">
    <parent link="joint6_flange"/>
    <child link="tcp"/>
    <origin xyz="0 0 $(arg tcp_offset)" rpy="0 0 0"/>
  </joint>

  <!-- ===================================================== wrist camera -->
  <!-- 4 cm ahead of the tool axis (flange +x), looking along the tool axis
       tilted 10 deg outwards so the fingers stay out of the image. -->
  <link name="wrist_camera_link">
    <xacro:box_visual xyz="0 0 0" size="0.015 0.03 0.02" material="arm_dark"/>
    <xacro:inertia m="0.02"/>
  </link>
  <joint name="wrist_camera_joint" type="fixed">
    <parent link="joint6_flange"/>
    <child link="wrist_camera_link"/>
    <origin xyz="0.04 0 0.01" rpy="0 -1.3963 0"/>
  </joint>
  <link name="wrist_camera_optical"/>
  <joint name="wrist_camera_optical_joint" type="fixed">
    <parent link="wrist_camera_link"/>
    <child link="wrist_camera_optical"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- ========================================================== gazebo -->
  <gazebo>
    <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
      <robotNamespace>/</robotNamespace>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
    <plugin name="planar_drive" filename="libgazebo_ros_planar_move.so">
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint_ground_truth</robotBaseFrame>
      <odometryRate>30.0</odometryRate>
      <cmdTimeout>1.0</cmdTimeout>
    </plugin>
  </gazebo>

  <gazebo reference="wrist_camera_link">
    <sensor type="camera" name="wrist_camera">
      <update_rate>10.0</update_rate>
      <camera name="wrist">
        <horizontal_fov>1.5</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>5.0</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="wrist_camera_plugin" filename="libgazebo_ros_camera.so">
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>wrist_camera</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>wrist_camera_optical</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link"><material>Gazebo/Grey</material></gazebo>
</robot>
