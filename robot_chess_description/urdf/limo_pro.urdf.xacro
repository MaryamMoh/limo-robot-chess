<?xml version="1.0"?>
<!--
  AgileX LIMO PRO (four wheel differential mode) for multi-robot simulation.

  Geometry, masses and sensor placement follow limo_description (limo_ros),
  the meshes are taken from that package.  Differences:
    * every link / TF frame carries the robot name as prefix ("white/base_link")
    * every Gazebo plugin publishes inside the robot namespace (/white/scan ...)
    * the drive plugin publishes ground-truth odometry on odom_ground_truth and
      does NOT broadcast TF; the noisy odometry + EKF chain does that instead
    * Gaussian noise on LiDAR, camera and IMU
    * a carrying plate on top, where transported chess pieces are placed

  Args:  prefix  robot name / namespace (no leading slash)
-->
<robot name="limo_pro" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="prefix" default="limo"/>
  <xacro:property name="p" value="$(arg prefix)"/>

  <xacro:property name="M_PI" value="3.14159265"/>
  <xacro:property name="base_x_size" value="0.13"/>
  <xacro:property name="base_y_size" value="0.12"/>
  <xacro:property name="base_z_size" value="0.10"/>
  <xacro:property name="base_mass" value="2.1557"/>
  <xacro:property name="wheelbase" value="0.2"/>
  <xacro:property name="track" value="0.13"/>
  <xacro:property name="wheel_vertical_offset" value="-0.10"/>
  <xacro:property name="wheel_length" value="0.045"/>
  <xacro:property name="wheel_radius" value="0.045"/>

  <!-- ============================================================ links -->
  <link name="${p}/base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="${p}/base_footprint"/>
    <child link="${p}/base_link"/>
    <origin xyz="0 0 0.15" rpy="0 0 0"/>
  </joint>

  <link name="${p}/base_link">
    <visual>
      <origin xyz="0 0 -0.15" rpy="0 0 1.57"/>
      <geometry>
        <mesh filename="package://limo_description/meshes/limo_base.dae" scale="1 1 1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x_size} ${base_y_size} ${base_z_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="${base_mass}"/>
      <inertia ixx="0.24" ixy="0" ixz="0" iyy="0.96" iyz="0" izz="0.96"/>
    </inertial>
  </link>

  <!-- Carrying plate (visual only) -->
  <link name="${p}/carrier_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.16 0.005"/>
      </geometry>
      <material name="plate_orange">
        <color rgba="0.95 0.45 0.05 1"/>
      </material>
    </visual>
  </link>
  <joint name="carrier_plate_joint" type="fixed">
    <parent link="${p}/base_link"/>
    <child link="${p}/carrier_plate"/>
    <origin xyz="0 0 0.105" rpy="0 0 0"/>
  </joint>

  <!-- LiDAR (EAI T-mini Pro) -->
  <link name="${p}/laser_link">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.01"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.032" length="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="${p}/base_link"/>
    <child link="${p}/laser_link"/>
    <origin xyz="0.103 0 -0.034" rpy="0 0 0"/>
  </joint>

  <!-- Depth camera (Orbbec Dabai) -->
  <link name="${p}/depth_camera_link">
    <visual>
      <geometry>
        <box size="0.02 0.06 0.015"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <box size="0.02 0.06 0.015"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="depth_camera_joint" type="fixed">
    <parent link="${p}/base_link"/>
    <child link="${p}/depth_camera_link"/>
    <origin xyz="0.084 0 0.03" rpy="0 0 0"/>
  </joint>
  <link name="${p}/depth_link"/>
  <joint name="depth_optical_joint" type="fixed">
    <parent link="${p}/depth_camera_link"/>
    <child link="${p}/depth_link"/>
    <origin xyz="0 0 0" rpy="${-M_PI/2} 0 ${-M_PI/2}"/>
  </joint>

  <!-- IMU -->
  <link name="${p}/imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="${p}/base_link"/>
    <child link="${p}/imu_link"/>
    <origin xyz="0 0 -0.1" rpy="0 0 0"/>
  </joint>

  <!-- Wheels -->
  <xacro:macro name="limo_wheel" params="name reflect *joint_pose">
    <link name="${p}/${name}_wheel_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="0.01055" ixy="0" ixz="0" iyy="0.00075" iyz="0" izz="0.01055"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://limo_description/meshes/limo_wheel.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin xyz="0 ${wheel_length/2} 0" rpy="1.57 0 0"/>
        <geometry>
          <cylinder length="${wheel_length}" radius="${wheel_radius}"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_wheel" type="continuous">
      <parent link="${p}/base_link"/>
      <child link="${p}/${name}_wheel_link"/>
      <xacro:insert_block name="joint_pose"/>
      <axis xyz="0 ${reflect} 0"/>
    </joint>
    <gazebo reference="${p}/${name}_wheel_link">
      <mu1>10</mu1>
      <mu2>10</mu2>
      <kp>10000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.01</minDepth>
      <fdir1>1 0 0</fdir1>
      <maxContacts>64</maxContacts>
    </gazebo>
  </xacro:macro>

  <xacro:limo_wheel name="front_left" reflect="1">
    <origin xyz="${wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:limo_wheel>
  <xacro:limo_wheel name="front_right" reflect="-1">
    <origin xyz="${wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0"/>
  </xacro:limo_wheel>
  <xacro:limo_wheel name="rear_left" reflect="1">
    <origin xyz="${-wheelbase/2} ${track/2} ${wheel_vertical_offset}" rpy="0 0 0"/>
  </xacro:limo_wheel>
  <xacro:limo_wheel name="rear_right" reflect="-1">
    <origin xyz="${-wheelbase/2} ${-track/2} ${wheel_vertical_offset}" rpy="${M_PI} 0 0"/>
  </xacro:limo_wheel>

  <!-- ================================================== gazebo plugins -->
  <gazebo reference="${p}/carrier_plate">
    <material>Gazebo/Orange</material>
  </gazebo>

  <gazebo>
    <plugin name="skid_steer_drive" filename="libgazebo_ros_skid_steer_drive.so">
      <updateRate>50.0</updateRate>
      <robotNamespace>/${p}</robotNamespace>
      <leftFrontJoint>front_left_wheel</leftFrontJoint>
      <rightFrontJoint>front_right_wheel</rightFrontJoint>
      <leftRearJoint>rear_left_wheel</leftRearJoint>
      <rightRearJoint>rear_right_wheel</rightRearJoint>
      <wheelSeparation>0.172</wheelSeparation>
      <wheelDiameter>0.09</wheelDiameter>
      <robotBaseFrame>${p}/base_footprint</robotBaseFrame>
      <commandTopic>cmd_vel</commandTopic>
      <torque>50</torque>
      <broadcastTF>false</broadcastTF>
      <odometryTopic>odom_ground_truth</odometryTopic>
      <odometryFrame>${p}/odom</odometryFrame>
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>

  <gazebo reference="${p}/laser_link">
    <sensor type="ray" name="laser_sensor">
      <visualize>false</visualize>
      <update_rate>8</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-2.09439504</min_angle>
            <max_angle>2.09439504</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.015</stddev>
        </noise>
      </ray>
      <plugin name="laser_plugin" filename="libgazebo_ros_laser.so">
        <robotNamespace>/${p}</robotNamespace>
        <topicName>scan</topicName>
        <frameName>${p}/laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="${p}/depth_camera_link">
    <sensor name="depth_camera" type="depth">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10.0</update_rate>
      <camera name="dabai">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_openni_kinect.so">
        <robotNamespace>/${p}</robotNamespace>
        <baseline>0.04</baseline>
        <alwaysOn>true</alwaysOn>
        <updateRate>0.0</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>color/image_raw</imageTopicName>
        <cameraInfoTopicName>color/camera_info</cameraInfoTopicName>
        <depthImageTopicName>depth/image_raw</depthImageTopicName>
        <depthImageCameraInfoTopicName>depth/camera_info</depthImageCameraInfoTopicName>
        <pointCloudTopicName>depth/points</pointCloudTopicName>
        <frameName>${p}/depth_link</frameName>
        <pointCloudCutoff>0.2</pointCloudCutoff>
        <pointCloudCutoffMax>5.0</pointCloudCutoffMax>
        <distortionK1>0</distortionK1>
        <distortionK2>0</distortionK2>
        <distortionK3>0</distortionK3>
        <distortionT1>0</distortionT1>
        <distortionT2>0</distortionT2>
        <CxPrime>0</CxPrime>
        <Cx>0</Cx>
        <Cy>0</Cy>
        <focalLength>0</focalLength>
        <hackBaseline>0</hackBaseline>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="${p}/imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <robotNamespace>/${p}</robotNamespace>
        <topicName>imu</topicName>
        <bodyName>${p}/imu_link</bodyName>
        <updateRateHZ>50.0</updateRateHZ>
        <gaussianNoise>0.005</gaussianNoise>
        <xyzOffset>0 0 0</xyzOffset>
        <rpyOffset>0 0 0</rpyOffset>
        <frameName>${p}/imu_link</frameName>
      </plugin>
    </sensor>
  </gazebo>
</robot>
