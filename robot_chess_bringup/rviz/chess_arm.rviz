Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 10
      Value: true
    - Class: rviz/RobotModel
      Name: Robot
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz/MarkerArray
      Name: Board (player's view)
      Enabled: true
      Marker Topic: /chess/board_markers
      Queue Size: 100
      Value: true
    - Class: rviz/TF
      Name: TF
      Enabled: false
      Value: false
    - Class: rviz/Image
      Name: Board reading
      Enabled: true
      Image Topic: /board_vision/debug_image
      Transport Hint: raw
      Value: true
    - Class: rviz/Image
      Name: Wrist camera
      Enabled: true
      Image Topic: /wrist_camera/image_raw
      Transport Hint: raw
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 0.9
      Focal Point:
        X: 0.15
        Y: 0
        Z: 0.2
      Pitch: 0.6
      Yaw: 3.6
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
