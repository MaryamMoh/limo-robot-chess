Panels:
  - Class: rviz/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
      Splitter Ratio: 0.5
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: false
      Value: false
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.6
      Color Scheme: map
      Value: true
    - Class: rviz/MarkerArray
      Name: Chessboard
      Enabled: true
      Marker Topic: /chess/board_markers
      Queue Size: 100
      Value: true
    - Class: rviz/RobotModel
      Name: White robot
      Enabled: true
      Robot Description: /white/robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz/RobotModel
      Name: Black robot
      Enabled: true
      Robot Description: /black/robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false
      Value: true
    - Class: rviz/LaserScan
      Name: White scan
      Enabled: true
      Topic: /white/scan
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Value: true
    - Class: rviz/LaserScan
      Name: Black scan
      Enabled: true
      Topic: /black/scan
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 85; 0
      Value: true
    - Class: rviz/PoseArray
      Name: White AMCL particles
      Enabled: true
      Topic: /white/particlecloud
      Color: 0; 170; 255
      Arrow Length: 0.15
      Value: true
    - Class: rviz/PoseArray
      Name: Black AMCL particles
      Enabled: true
      Topic: /black/particlecloud
      Color: 255; 0; 127
      Arrow Length: 0.15
      Value: true
    - Class: rviz/Path
      Name: White plan
      Enabled: true
      Topic: /white/route
      Color: 0; 255; 0
      Value: true
    - Class: rviz/Path
      Name: Black plan
      Enabled: true
      Topic: /black/route
      Color: 255; 255; 0
      Value: true
    - Class: rviz/Image
      Name: White camera
      Enabled: true
      Image Topic: /white/vision/debug_image
      Transport Hint: raw
      Value: true
    - Class: rviz/Image
      Name: Black camera
      Enabled: true
      Image Topic: /black/vision/debug_image
      Transport Hint: raw
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Distance: 14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 1.1
      Yaw: -1.5708
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1500
