Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Map
      Name: Map
      Enabled: true
      Topic: /map
      Alpha: 0.7
      Color Scheme: map
      Value: true
    - Class: rviz/MarkerArray
      Name: Chessboard
      Enabled: true
      Marker Topic: /chess/board_markers
      Queue Size: 100
      Value: true
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: false
      Value: true
    - Class: rviz/LaserScan
      Name: Scan
      Enabled: true
      Topic: /scan
      Size (m): 0.04
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 255; 255
      Value: true
    - Class: rviz/PoseArray
      Name: AMCL particles
      Enabled: true
      Topic: /particlecloud
      Color: 0; 170; 255
      Arrow Length: 0.15
      Value: true
    - Class: rviz/Path
      Name: Plan
      Enabled: true
      Topic: /move_base/GlobalPlanner/plan
      Color: 0; 255; 0
      Value: true
    - Class: rviz/Image
      Name: Camera
      Enabled: true
      Image Topic: /vision/debug_image
      Transport Hint: raw
      Value: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
  Value: true
  Views:
    Current:
      Class: rviz/TopDownOrtho
      Name: Current View
      Scale: 80
      X: 0
      Y: 0
      Target Frame: <Fixed Frame>
Window Geometry:
  Height: 900
  Width: 1400
