<?xml version="1.0"?>
<!--
  Test my chess robot in Gazebo before the laboratory:
  table + board + pieces, my LIMO + myCobot with its player software, and a
  stand-in for the opponent's robot playing the other side.

  Watch the game:  rosrun robot_chess_game chess_monitor.py
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="config" default="$(find robot_chess_game)/config/player_sim.yaml"/>
  <arg name="opponent" default="true"/>
  <arg name="opponent_strategy" default="engine"/>   <!-- engine | random -->

  <include file="$(find robot_chess_gazebo)/launch/sim_world.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="config" value="$(arg config)"/>
    <arg name="opponent" value="$(arg opponent)"/>
    <arg name="opponent_strategy" value="$(arg opponent_strategy)"/>
  </include>

  <include file="$(find robot_chess_game)/launch/player.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="virtual_grasp" value="true"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find robot_chess_bringup)/rviz/chess_arm.rviz"/>
</launch>
