<?xml version="1.0"?>
<!--
  Complete simulation: Gazebo arena, 32 pieces, two LIMO PRO robots
  (white and black) with localisation, navigation, camera verification and
  move execution, the chess referee and RViz.

  The two human players then open one terminal each:
      rosrun robot_chess_game player_console.py white
      rosrun robot_chess_game player_console.py black
-->
<launch>
  <arg name="gui" default="true"/>
  <arg name="rviz" default="true"/>
  <arg name="board_config" default="$(find robot_chess_game)/config/board_sim.yaml"/>
  <arg name="map" default="$(find robot_chess_navigation)/maps/chess_arena.yaml"/>

  <!-- known initial poses (= home poses in board_sim.yaml) -->
  <arg name="white_x" default="0.0"/>
  <arg name="white_y" default="-3.9"/>
  <arg name="white_yaw" default="1.5708"/>
  <arg name="black_x" default="0.0"/>
  <arg name="black_y" default="3.9"/>
  <arg name="black_yaw" default="-1.5708"/>

  <!-- world + pieces -->
  <include file="$(find robot_chess_gazebo)/launch/arena.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="board_config" value="$(arg board_config)"/>
  </include>

  <!-- known map, shared by both robots -->
  <node pkg="map_server" type="map_server" name="map_server" args="$(arg map)">
    <param name="frame_id" value="map"/>
  </node>

  <!-- ============================ WHITE robot ============================ -->
  <include file="$(find robot_chess_gazebo)/launch/spawn_limo.launch">
    <arg name="robot_name" value="white"/>
    <arg name="x" value="$(arg white_x)"/>
    <arg name="y" value="$(arg white_y)"/>
    <arg name="yaw" value="$(arg white_yaw)"/>
  </include>
  <include file="$(find robot_chess_navigation)/launch/robot_navigation.launch">
    <arg name="robot_name" value="white"/>
    <arg name="initial_x" value="$(arg white_x)"/>
    <arg name="initial_y" value="$(arg white_y)"/>
    <arg name="initial_yaw" value="$(arg white_yaw)"/>
  </include>
  <include file="$(find robot_chess_game)/launch/robot_game.launch">
    <arg name="robot_name" value="white"/>
    <arg name="color" value="white"/>
    <arg name="board_config" value="$(arg board_config)"/>
  </include>

  <!-- ============================ BLACK robot ============================ -->
  <include file="$(find robot_chess_gazebo)/launch/spawn_limo.launch">
    <arg name="robot_name" value="black"/>
    <arg name="x" value="$(arg black_x)"/>
    <arg name="y" value="$(arg black_y)"/>
    <arg name="yaw" value="$(arg black_yaw)"/>
  </include>
  <include file="$(find robot_chess_navigation)/launch/robot_navigation.launch">
    <arg name="robot_name" value="black"/>
    <arg name="initial_x" value="$(arg black_x)"/>
    <arg name="initial_y" value="$(arg black_y)"/>
    <arg name="initial_yaw" value="$(arg black_yaw)"/>
  </include>
  <include file="$(find robot_chess_game)/launch/robot_game.launch">
    <arg name="robot_name" value="black"/>
    <arg name="color" value="black"/>
    <arg name="board_config" value="$(arg board_config)"/>
  </include>

  <!-- ============================== game ================================= -->
  <node pkg="robot_chess_game" type="chess_referee.py" name="chess_referee" output="screen">
    <rosparam command="load" file="$(arg board_config)"/>
    <rosparam param="robots">{white: /white, black: /black}</rosparam>
  </node>

  <node pkg="robot_chess_game" type="board_visualizer.py" name="board_visualizer">
    <rosparam command="load" file="$(arg board_config)"/>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find robot_chess_bringup)/rviz/chess.rviz"/>
</launch>
