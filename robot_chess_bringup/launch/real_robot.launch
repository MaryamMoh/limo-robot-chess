<?xml version="1.0"?>
<!--
  My chess robot in the laboratory: real LIMO + myCobot 280, wrist USB
  camera, the opponent's robot (another team's software) on the other side.

  Before the first game:
    * pip3 install pymycobot chess
    * calibrate the wrist camera once (intrinsics, see the README)
    * fill in robot_chess_game/config/player_real.yaml and run check_reach.py
    * set the pieces in the start position; the robot learns the board
      colours from it, so do not touch the board until it says "ready"
-->
<launch>
  <arg name="config" default="$(find robot_chess_game)/config/player_real.yaml"/>
  <arg name="port" default="/dev/ttyTHS1"/>
  <arg name="baud" default="1000000"/>
  <arg name="start_camera" default="true"/>
  <arg name="video_device" default="/dev/video0"/>
  <arg name="camera_info_url" default="file://$(env HOME)/.ros/camera_info/wrist_camera.yaml"/>
  <arg name="start_base" default="false"/>   <!-- only needed with base stations -->
  <arg name="tcp_offset" default="0.06"/>
  <arg name="rviz" default="false"/>

  <param name="robot_description"
         command="$(find xacro)/xacro '$(find robot_chess_description)/urdf/limo_mycobot.urdf.xacro' tcp_offset:=$(arg tcp_offset)"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

  <node pkg="robot_chess_game" type="mycobot_driver.py" name="mycobot_driver" output="screen">
    <param name="port" value="$(arg port)"/>
    <param name="baud" value="$(arg baud)"/>
  </node>

  <node if="$(arg start_camera)" pkg="usb_cam" type="usb_cam_node" name="wrist_camera" output="screen">
    <param name="video_device" value="$(arg video_device)"/>
    <param name="image_width" value="640"/>
    <param name="image_height" value="480"/>
    <param name="pixel_format" value="yuyv"/>
    <param name="camera_frame_id" value="wrist_camera_optical"/>
    <param name="camera_name" value="wrist_camera"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
  </node>

  <include if="$(arg start_base)" file="$(find limo_base)/launch/limo_base.launch"/>

  <include file="$(find robot_chess_game)/launch/player.launch">
    <arg name="config" value="$(arg config)"/>
    <arg name="virtual_grasp" value="false"/>
  </include>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find robot_chess_bringup)/rviz/chess_arm.rviz"/>
</launch>
