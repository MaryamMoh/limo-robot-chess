<?xml version="1.0"?>
<!--
  Build a map of the laboratory with the real LIMO PRO before playing.
  Drive the robot around (e.g. limo_teletop_keyboard.launch), then save:
    rosrun map_server map_saver -f $(rospack find robot_chess_navigation)/maps/lab
-->
<launch>
  <arg name="base_frame" default="base_link"/>
  <arg name="odom_frame" default="odom"/>

  <node pkg="robot_localization" type="ekf_localization_node" name="ekf" output="screen">
    <rosparam command="load" file="$(find robot_chess_navigation)/config/ekf.yaml"/>
    <param name="world_frame" value="$(arg odom_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="base_link_frame" value="$(arg base_frame)"/>
  </node>

  <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
    <param name="base_frame" value="$(arg base_frame)"/>
    <param name="odom_frame" value="$(arg odom_frame)"/>
    <param name="map_frame" value="map"/>
    <param name="map_update_interval" value="2.0"/>
    <param name="maxUrange" value="8.0"/>
    <param name="particles" value="60"/>
    <param name="delta" value="0.05"/>
    <param name="linearUpdate" value="0.1"/>
    <param name="angularUpdate" value="0.2"/>
    <param name="xmin" value="-10.0"/>
    <param name="ymin" value="-10.0"/>
    <param name="xmax" value="10.0"/>
    <param name="ymax" value="10.0"/>
  </node>
</launch>
