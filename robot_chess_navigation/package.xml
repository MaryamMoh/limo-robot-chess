<?xml version="1.0"?>
<package format="2">
  <name>robot_chess_navigation</name>
  <version>1.0.0</version>
  <description>Noisy odometry, EKF sensor fusion, AMCL localisation and move_base navigation for the chess robots.</description>
  <maintainer email="maryammohamedmahmoud@gmail.com">Maryam Abd-ElRahman</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>robot_chess_game</exec_depend>
  <exec_depend>robot_localization</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>global_planner</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>gmapping</exec_depend>
</package>
